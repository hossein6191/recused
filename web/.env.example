# The deployed Recused contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty the site says "no register configured yet" and offers the Deploy page.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory stand-in for the contract (lib/chain-mock.ts), with demo content,
# no wallet and no network. For local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=
