{
  "name": "recused-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node tools/dev.mjs",
    "build": "node tools/sync-contract.mjs --check && find .next -name '._*' -delete 2>/dev/null; next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sync:contract": "node tools/sync-contract.mjs",
    "check:contract": "node tools/sync-contract.mjs --check",
    "test:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.mjs",
    "test:practice": "node tests/site/practice.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "genlayer-js": "^1.1.8",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "motion": "^14.0.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
